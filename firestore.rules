rules_version = '2';

// Access model: no per-user accounts. Any signed-in client (anonymous auth,
// see js/firebase-init.js) that knows a workspace's shared code can read/write
// that workspace's data. The workspace code itself is the access control —
// treat it like a shared password, not a public identifier.
//
// Every collection directly under a workspace (sales, products, events, and any
// added later) follows that same rule, so adding a feature needs no rule change.
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId}/{collection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
